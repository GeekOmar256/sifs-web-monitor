{
  "rules": {
    "farms": {
      "sifs": {
        ".read": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'anonymous')",
        "settings": {
          ".write": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'anonymous')"
        },
        "commands": {
          "captureRequest": {
            ".write": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'anonymous')"
          }
        },
        "history": {
          "settings": {
            "$entry": {
              ".write": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'anonymous') && !data.exists()"
            }
          }
        }
      }
    }
  }
}
