        "settings": {
          ".write": "auth != null && auth.token.email_verified === true && (auth.token.email === 'smartfarm@gmail.com' || auth.token.email === 'smartfarm2026@gmail.com')"
        },
        "commands": {
          "captureRequest": {
            ".write": "auth != null && auth.token.email_verified === true && (auth.token.email === 'smartfarm@gmail.com' || auth.token.email === 'smartfarm2026@gmail.com')"
          }
        },
        "history": {
