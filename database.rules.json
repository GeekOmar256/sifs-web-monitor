            "$entry": {
              ".write": "auth != null && auth.token.email_verified === true && (auth.token.email === 'smartfarm@gmail.com' || auth.token.email === 'smartfarm2026@gmail.com') && !data.exists()"
            }
          },
          "analyses": {
            "$entry": {
              ".write": "auth != null && auth.token.email_verified === true && (auth.token.email === 'smartfarm@gmail.com' || auth.token.email === 'smartfarm2026@gmail.com') && !data.exists()"
            }
          }
        }
